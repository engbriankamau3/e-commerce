# Server & Runtime
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary Database (leave blank in preview for persistent local fallback store)
MONGODB_URI=

# JWT & Admin Authentication
# JWT_SECRET falls back to an in-memory random 32-byte key in dev if omitted
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe Payments (Server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Safaricom Daraja M-Pesa (Server-only)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_USD_TO_KES_RATE=130

# CJ Dropshipping (Server-only)
CJ_API_KEY=

# Firebase Auth Verification (Server-only service account JSON base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Client-only Public Firebase Config (safe to expose to browser)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
