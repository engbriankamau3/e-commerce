---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AccountIsland } from '../components/AccountIsland';
---

<BaseLayout title="Account — Kora & Co." currentPath="/account">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="mb-8 text-center">
      <p class="text-xs font-medium text-[#5C5B57] mb-2">Customer Account</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-[#141413]">
        Sign In or Create Account
      </h1>
      <p class="mt-2 text-sm text-[#5C5B57]">
        Sync your shopping bag across devices and review verified order history.
      </p>
    </div>
    <AccountIsland client:load />
  </div>
</BaseLayout>
