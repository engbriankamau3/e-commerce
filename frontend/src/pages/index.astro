---
import BaseLayout from '../layouts/BaseLayout.astro';
import { StorefrontCatalog } from '../components/StorefrontCatalog';
import { HERO_IMAGE_PATH, SAMPLE_PRODUCTS } from '../../../shared/src/catalogSeed';
---

<BaseLayout currentPath="/">
  <!-- Editorial Split Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch bg-white border border-[#141413]/10 rounded-lg overflow-hidden">
      <div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-between gap-8">
        <div>
          <p class="text-xs font-medium text-[#5C5B57] mb-3">
            Autumn Release · Verified Direct Checkout
          </p>
          <h1 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight text-[#141413] leading-[1.12]">
            Durable Objects for Daily Transit
          </h1>
          <p class="mt-4 text-sm sm:text-base text-[#5C5B57] leading-relaxed max-w-[52ch]">
            Waxed cotton carry, kiln-fired stoneware, and field timepieces. Every order is priced server-side and settled via Stripe or M-Pesa Daraja before dispatch.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#collection"
            class="min-h-[44px] px-6 py-3 text-sm font-semibold bg-[#1B4332] text-white rounded-md hover:bg-[#143326] transition-colors inline-flex items-center justify-center"
          >
            Explore Collection
          </a>
          <a
            href="/track"
            class="min-h-[44px] px-5 py-3 text-sm font-medium border border-[#141413]/15 text-[#141413] rounded-md hover:bg-[#F3F2EE] transition-colors inline-flex items-center justify-center"
          >
            Track &amp; Edit Pickup
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 min-h-[260px] sm:min-h-[380px] bg-[#F3F2EE]">
        <img
          src={HERO_IMAGE_PATH}
          alt="Kora & Co. waxed canvas tote, ceramic pour-over vessel, and titanium field watch on travertine"
          referrerpolicy="no-referrer"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Featured Collection Island -->
  <StorefrontCatalog client:load initialProducts={SAMPLE_PRODUCTS} />

  <!-- Store-Managed Pickup & Verification Story -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-[#141413]/10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <p class="text-xs font-medium text-[#5C5B57] mb-2">01 · Authoritative Pricing</p>
        <h3 class="text-base font-semibold text-[#141413]">Server-Verified Totals</h3>
        <p class="mt-2 text-sm text-[#5C5B57] leading-relaxed">
          Every line item, variant stock check, and KES conversion rate is computed by our API prior to payment initiation.
        </p>
      </div>
      <div>
        <p class="text-xs font-medium text-[#5C5B57] mb-2">02 · Confirmed Settlement</p>
        <h3 class="text-base font-semibold text-[#141413]">Stripe &amp; Daraja M-Pesa</h3>
        <p class="mt-2 text-sm text-[#5C5B57] leading-relaxed">
          Orders remain pending until signed Stripe webhooks or Safaricom Daraja callbacks verify the exact settled amount.
        </p>
      </div>
      <div>
        <p class="text-xs font-medium text-[#5C5B57] mb-2">03 · Store-Managed Pickup</p>
        <h3 class="text-base font-semibold text-[#141413]">Flexible Hub Selection</h3>
        <p class="mt-2 text-sm text-[#5C5B57] leading-relaxed">
          Update your preferred Nairobi or Mombasa collection station anytime at <a href="/track" class="underline text-[#141413]">/track</a> before your parcel is marked Ready for Pickup.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
