{
  "name": "kora-commerce-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "admin"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "astro build --root frontend",
    "build:admin": "vite build admin",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "NODE_ENV=production tsx server.ts",
    "clean": "rm -rf dist frontend/dist admin/dist frontend/.astro",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "5.18.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.12.3",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^23.2.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
